# Copy to inference/.env and fill in. inference/.env is gitignored.
# Public endpoint: SHOW ENDPOINTS IN SERVICE SPS_RETAIL_AI.ML_INFERENCE.FULFILLMENT_RISK_SVC;
INFERENCE_URL=https://<id>-<account>.snowflakecomputing.app
# Optional: defaults to https://<account-with-hyphens>.snowflakecomputing.com from your connection
CORTEX_BASE_URL=
# Optional: if unset, the PAT is read from the connection below in ~/.snowflake/connections.toml
SNOWFLAKE_PAT=
SNOWFLAKE_CONNECTION_NAME=coco_conn
